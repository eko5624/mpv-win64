pkgname=(mpv-dev libmpv-git mpv-git)
pkgver=0.41.0
pkgrel=1
pkgdesc='a free, open source, and cross-platform media player'
arch=('x86_64')
url='https://mpv.io/'
makedepends=("angle-headers-dev"
             "ffmpeg-static-dev"
             "mujs-dev"
             "rubberband-dev"
             "luajit2-dev" 
             "freetype2-dev"
             "fribidi-dev"
             "harfbuzz-dev"
             "libarchive-dev"
             "libass-dev"
             "libbluray-dev"
             "libdvdnav-dev"
             "libjpeg-dev"
             "libplacebo-dev"
             "libpng-dev"
             "libsdl2-dev"
             "libsixel-dev"
             "lcms2-dev"
             "shaderc-dev"
             "spirv-cross-dev"
             "vapoursynth-dev"
             "vulkan-dev"
             "zlib-dev")
license=('GPL3')
source=("git+https://github.com/mpv-player/mpv.git")
md5sums=('SKIP')

build() {
  eval "${mpv_cflags}"
  eval "${mpv_ldflags}"
  cd $srcdir/mpv
  meson setup build \
    --buildtype=release \
    --prefix=/opt \
    --libdir='/opt/lib' \
    -Dlibmpv=true \
    -Dlua=enabled \
    -Dopenal=enabled \
    -Drubberband=enabled \
    -Dsdl2-gamepad=enabled \
    -Dlibbluray=enabled \
    -Ddvdnav=enabled \
    -Degl-angle=enabled \
    -Dlibarchive=enabled
    
  meson compile -C build
  
  # get latest commit sha
  short_sha=$(git rev-parse --short HEAD)
  echo $short_sha > SHORT_SHA
}

package_mpv-dev() {
  cd $srcdir/mpv
  DESTDIR=$pkgdir meson install -C build
  mv $pkgdir/msys64/* $pkgdir
  rm -rf $pkgdir/opt/bin
  rm -rf $pkgdir/msys64
}

package_libmpv-git() {
  export PKGEXT='.pkg.tar.xz'
  mkdir -p $pkgdir/opt/libmpv/include/mpv
  cd $srcdir/mpv/build
  strip -s libmpv-2.dll
  mv libmpv-2.dll $pkgdir/opt/libmpv
  mv libmpv.dll.a $pkgdir/opt/libmpv
  mv ../include/mpv/client.h $pkgdir/opt/libmpv/include/mpv
  mv ../include/mpv/stream_cb.h $pkgdir/opt/libmpv/include/mpv
  mv ../include/mpv/render.h $pkgdir/opt/libmpv/include/mpv
  mv ../include/mpv/render_gl.h $pkgdir/opt/libmpv/include/mpv
}

package_mpv-git() {
  export PKGEXT='.pkg.tar.xz'
  mkdir -p $pkgdir/opt/mpv
  cd $srcdir/mpv/build
  mv mpv.exe $pkgdir/opt/mpv
  mv mpv.com $pkgdir/opt/mpv
  strip -s $pkgdir/opt/mpv/mpv.*
  mv ../SHORT_SHA $pkgdir/opt/mpv
}
