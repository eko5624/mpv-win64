pkgname=vvdec-dev
pkgver=3.0.0
pkgrel=1
pkgdesc='the Fraunhofer Versatile Video Decoder'
arch=('x86_64')
url="https://github.com/fraunhoferhhi/vvdec"
license=('BSD')
source=("git+https://github.com/fraunhoferhhi/vvdec.git")
md5sums=('SKIP')

build() {
  cd $srcdir/vvdec
  # cast memset with void * to silence nontrivial-memcall warning
  curl -OL https://raw.githubusercontent.com/m-ab-s/mabs-patches/refs/heads/master/vvdec/0001-TypeDef-cast-mem-cpy-set-this-.-with-void-to-silence.patch
  curl -OL https://raw.githubusercontent.com/m-ab-s/mabs-patches/refs/heads/master/vvdec/0002-CodingStructure-cast-memset-with-void-to-silence-non.patch
  git apply 0001-TypeDef-cast-mem-cpy-set-this-.-with-void-to-silence.patch
  git apply 0002-CodingStructure-cast-memset-with-void-to-silence-non.patch
  rm -rf build && mkdir build && cd build
  cmake .. \
    -G "Ninja" \
    -DCMAKE_INSTALL_PREFIX=/opt \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DCCACHE_FOUND=OFF \
    -DVVDEC_ENABLE_LINK_TIME_OPT=OFF \
    -DVVDEC_ENABLE_WERROR=OFF
  cmake --build .
}

package() {
  cd $srcdir/vvdec/build
  DESTDIR=$pkgdir cmake --install .
  mv $pkgdir/msys64/* $pkgdir
  rm -rf $pkgdir/msys64
}
