pkgname=libdvdcss-dev
pkgver=1.5.0
pkgrel=1
pkgdesc='Portable abstraction library for DVD decryption'
arch=('x86_64')
url="https://www.videolan.org/developers/libdvdcss.html"
license=('GPL')
source=("git+https://code.videolan.org/videolan/libdvdcss.git")
md5sums=('SKIP')

build() {
  cd $srcdir/libdvdcss
  meson setup work \
    --prefix=/opt \
    --buildtype=release \
    --default-library=static
  meson compile -C work
}

package() {
  cd $srcdir/libdvdcss
  DESTDIR=$pkgdir meson install -C work
  mv $pkgdir/msys64/* $pkgdir
  rm -rf $pkgdir/msys64
}
