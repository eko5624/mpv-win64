# Maintainer: nyfair <nyfair2012@gmail.com>
pkgname=libdvdnav-dev
pkgver=7.0.0
pkgrel=1
pkgdesc='The library for xine-dvdnav plugin'
arch=('x86_64')
url="https://www.videolan.org/developers/libdvdnav.html"
makedepends=('libdvdcss-dev' 'libdvdread-dev')
license=('GPL')
source=("git+https://code.videolan.org/videolan/libdvdnav.git")
md5sums=('SKIP')

build() {
  cd $srcdir/libdvdnav
  meson setup work \
    --prefix=/opt \
    --buildtype=release \
    --default-library=static
  meson compile -C work
}

package() {
  cd $srcdir/libdvdnav
  DESTDIR=$pkgdir meson install -C work
  mv $pkgdir/msys64/* $pkgdir
  rm -rf $pkgdir/msys64
}
