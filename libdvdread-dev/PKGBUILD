pkgname=libdvdread-dev
pkgver=6.1.3
pkgrel=1
pkgdesc='Provides a simple foundation for reading DVD video disks'
arch=('x86_64')
url="https://www.videolan.org/developers/libdvdnav.html"
makedepends=('libdvdcss-dev')
license=('GPL')
source=("git+https://code.videolan.org/videolan/libdvdread.git")
md5sums=('SKIP')

build() {
  cd $srcdir/libdvdread
  sed -i '/^if import/,/^endif/d' meson.build
  meson setup work \
    --prefix=/opt \
    --buildtype=release \
    --default-library=static \
    -Dlibdvdcss=enabled
  meson compile -C work
}

package() {
  cd $srcdir/libdvdread
  DESTDIR=$pkgdir meson install -C work
  mv $pkgdir/msys64/* $pkgdir
  rm -rf $pkgdir/msys64
}
