pkgname=libbluray-dev
pkgver=1.4.1
pkgrel=1
pkgdesc='Library to access Blu-Ray disks for video playback'
arch=('x86_64')
url="https://www.videolan.org/developers/libbluray.html"
makedepends=('freetype2-dev' 'libpng-dev' 'libudfread-dev' 'zlib-dev')
license=('GPL')
source=("git+https://code.videolan.org/videolan/libbluray.git")
md5sums=('SKIP')

build() {
  cd $srcdir/libbluray
  meson setup work \
    --prefix=/opt \
    --buildtype=release \
    --default-library=static \
    -Denable_tools=false \
    -Dbdj_jar=disabled \
    -Dlibxml2=disabled \
    -Dfontconfig=disabled \
    -Dc_args="-Ddec_init=libbluray_dec_init -Ddir_open_default=libbluray_dir_open_default -Dfile_open_default=libbluray_file_open_default"
  meson compile -C work
}

package() {
  cd $srcdir/libbluray
  DESTDIR=$pkgdir meson install -C work
  mv $pkgdir/msys64/* $pkgdir
  rm -rf $pkgdir/msys64
}
