pkgname=harfbuzz-dev
pkgver=11.4.4
pkgrel=1
pkgdesc='OpenType text shaping engine'
arch=('x86_64')
url="https://github.com/harfbuzz/harfbuzz/"
makedepends=('freetype2-dev' 'libpng-dev')
license=('GPL')
source=("git+https://github.com/harfbuzz/harfbuzz.git#tag=$pkgver")
md5sums=('SKIP')

build() {
  cd $srcdir/harfbuzz
  meson setup build \
    --prefix=/opt \
    --buildtype=release \
    --default-library=static \
    -Dicu=disabled \
    -Dglib=disabled \
    -Dgobject=disabled \
    -Dtests=disabled \
    -Ddocs=disabled \
    -Dbenchmark=disabled
  meson compile -C build
}

package() {
  cd $srcdir/harfbuzz
  DESTDIR=$pkgdir meson install -C build
  mv $pkgdir/msys64/* $pkgdir
  rm -rf $pkgdir/msys64
}
