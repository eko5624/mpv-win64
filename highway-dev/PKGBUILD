pkgname=highway-dev
pkgver=1.4.0
pkgrel=1
pkgdesc='C++ library for SIMD (Single Instruction, Multiple Data)'
arch=('x86_64')
url="https://github.com/google/highway/"
license=('Apache-2.0')
source=("git+https://github.com/google/highway.git#tag=$pkgver")
md5sums=('SKIP')

build() {
  eval "${att_args}"
  cd $srcdir/highway
  meson setup work \
    --prefix=/opt \
    --buildtype=release \
    --default-library=static \
    -Dcontrib=disabled \
    -Dexamples=disabled \
    -Dtests=disabled
  meson compile -C work
}

package() {
  cd $srcdir/highway
  DESTDIR=$pkgdir meson install -C work
  mv $pkgdir/msys64/* $pkgdir
  rm -rf $pkgdir/msys64
}


