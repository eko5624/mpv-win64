pkgname=libzimg-dev
pkgver=3.0.6
pkgrel=1
pkgdesc='Scaling, colorspace conversion, and dithering library'
arch=('x86_64')
url="https://github.com/sekrit-twc/"
license=('LGPL')
source=("git+https://github.com/sekrit-twc/zimg.git"
        "git+https://github.com/sekrit-twc/graphengine.git"
        "https://github.com/msys2/MINGW-packages/blob/master/mingw-w64-zimg/0001-zimg-export-def-symbols.patch")
md5sums=('SKIP' 'SKIP' 'SKIP')

build() {
  cd $srcdir/zimg
  rm -rf graphengine 
  mv $srcdir/graphengine ./
  patch -p1 -i $srcdir/0001-zimg-export-def-symbols.patch
  ./autogen.sh
  ./configure --prefix=/opt --disable-shared --enable-static --with-pic
  make 
}

package() {
  cd $srcdir/zimg
  make DESTDIR=$pkgdir install
}
