pkgname=zstd-dev
pkgver=1.5.7
pkgrel=1
pkgdesc='Zstandard - Fast real-time compression algorithm'
arch=('x86_64')
url="https://facebook.github.io/zstd/"
license=('BSD')
source=("git+https://github.com/facebook/zstd.git")
md5sums=('SKIP')

build() {  
  cd $srcdir/zstd
  meson setup build --prefix=/opt --buildtype=release --default-library=static \
    --libdir=/opt/lib \
    -Dlegacy_level=0 \
    -Ddebug_level=0 \
    -Dbin_programs=false \
    -Dzlib=disabled \
    -Dlzma=disabled \
    -Dlz4=disabled
  meson compile -C build      
}

package() {
  cd $srcdir/zstd
  DESTDIR=$pkgdir meson install -C build
  mv $pkgdir/msys64/* $pkgdir
  rm -rf $pkgdir/msys64
}
